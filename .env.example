# Copy to .env — never commit your real keys.

# Optional. Only needed for AI blogs and Instagram carousels.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Overrides the default model in tubelog.config.js
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional. Speech model for translation audio. Must support audio output.
# OPENROUTER_TTS_MODEL=openai/gpt-4o-audio-preview

# Optional. Better web search for the ideas agent. The agent works without these using free sources.
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# Optional
# PORT=3000
# TUBELOG_GENERATED_DIR=./generated
# TUBELOG_VIDEOS_DIR=./videos
