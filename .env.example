# OpenRouter — required only when you generate AI blogs.
# 1. Create an account at https://openrouter.ai
# 2. Create a key at https://openrouter.ai/keys
# 3. Copy this file to .env and paste the key below.
OPENROUTER_API_KEY=

# Optional. Overrides ai.model in tubelog.config.js.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional overrides.
# TUBELOG_VIDEOS_DIR=./videos
# TUBELOG_GITHUB_URL=https://github.com/yourname/tubelog
# PORT=8787
