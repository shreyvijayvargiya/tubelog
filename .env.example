# Copy to .env — never commit your real keys.

# Optional. Only needed for AI blogs and Instagram carousels.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Overrides the default model in tubelog.config.js
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional
# PORT=3000
# TUBELOG_VIDEOS_DIR=./videos
