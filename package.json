{
  "name": "tubelog",
  "version": "0.1.0",
  "description": "Turn YouTube into your local Markdown learning library.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tubelog": "./src/cli.js"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"node --watch index.js\" \"vite --config dashboard/vite.config.js\"",
    "build": "vite build --config dashboard/vite.config.js",
    "start": "NODE_ENV=production PORT=3000 node index.js",
    "tubelog": "node src/cli.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "hono": "^4.9.6",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "youtube-transcript-plus": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.11",
    "vite": "^6.3.5"
  }
}
